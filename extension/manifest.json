{
	"manifest_version": 3,
	"name": "Funbridge History Exporter",
	"version": "2.1.0",
	"description": "Exports your tournament history from a signed-in Funbridge tab and saves it as PBN 2.1 files, locally and optionally to Google Drive.",
	"permissions": [
		"activeTab",
		"debugger",
		"downloads",
		"identity",
		"notifications",
		"storage"
	],
	"host_permissions": [
		"https://*.funbridge.com/*",
		"https://*.funbridge.net/*",
		"https://www.googleapis.com/*"
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "Export Funbridge history as PBN",
		"default_popup": "popup.html"
	},
	"icons": {
		"16": "icons/icon-16.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	}
}
