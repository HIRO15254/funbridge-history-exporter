{
	"manifest_version": 3,
	"name": "Funbridge History Exporter",
	"version": "2.0.0",
	"description": "Exports your tournament history from a signed-in Funbridge tab and saves it locally as PBN 2.1 files.",
	"permissions": ["activeTab", "debugger", "downloads"],
	"host_permissions": [
		"https://*.funbridge.com/*",
		"https://*.funbridge.net/*"
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "Export Funbridge history as PBN",
		"default_popup": "popup.html"
	}
}
